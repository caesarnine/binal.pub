---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, postPath, description, displayDate, slugify, type Post } from '../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map(post => ({ params: { path: postPath(post.data).slice(1, -1) }, props: { entry: post, isPost: true } })),
    ...pages.map(entry => ({ params: { path: entry.id }, props: { entry, isPost: false } })),
  ];
}
const { entry, isPost } = Astro.props;
const { Content } = await render(entry);
const post = entry as Post;
const minutes = isPost ? Math.max(1, Math.ceil((entry.body || '').split(/\s+/).length / 220)) : 0;
---
<Base title={entry.data.title} description={isPost ? description(post) : `${entry.data.title} · Binal Patel`} kind={isPost ? 'article' : 'page'} date={isPost ? post.data.date : undefined}>
  <header class="page-heading">
    <p class="eyebrow"><a href="/post/">{isPost ? 'Writing' : 'Binal Patel'}</a></p>
    <h1>{entry.data.title}</h1>
    {isPost && <div class="article-meta"><time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time><span>{minutes} min read</span></div>}
  </header>
  <article class="prose"><Content /></article>
  {isPost && <div class="article-end">
    <ul class="tag-links" aria-label="Post tags">{post.data.tags.map(tag => <li><a href={`/tags/${slugify(tag)}/`}>{tag}</a></li>)}</ul>
    <a class="text-link" href="/post/">← All writing</a>
  </div>}
</Base>
